# default - reNews
PROJECT_NAME=reNews
# default - development or set to production
ENVIRONMENT=development

# ---DATABASE CONFIG---
# Required
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# default - 'db' or set to localhost for local machine
POSTGRES_HOST=localhost
# default - 5432
POSTGRES_PORT=5432


# ---ADMIN SEQURITY---
# Required
JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=
# default - HS256
ALGORITHM=HS256
# default - 60 minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---AI CONFIG (claude CLI)---
# Path to the claude CLI binary; it uses the host's subscription login
# default - claude (set an absolute path when running under systemd)
CLAUDE_BIN=claude
# default - haiku, model alias passed to `claude --model`
AI_MODEL=haiku
# default - 10, articles analyzed per CLI invocation
AI_BATCH_SIZE=10
# default - 300, seconds before a CLI call is aborted
AI_TIMEOUT_SECONDS=300

# ---WORKER CONFIG---
# default - reNews-Reader/2.0 (+https://github.com/andriydread/reNews)
USER_AGENT=reNews-Reader/2.0 (+https://github.com/andriydread/reNews)
# default - 15000, Limit text sent to AI to save tokens
MAX_CONTENT_LENGTH=15000
# Worker cadence is set in deploy/renews-worker.timer, not here